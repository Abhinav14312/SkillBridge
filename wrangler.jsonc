{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skillbridge-prototype",
	"main": "worker.js",
	"keep_vars": true,
	"compatibility_date": "2026-11-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/health"
		]
	},
	"d1_databases": [
		{
			"binding": "skillbridge_db",
			"database_name": "skillbridge-db",
			"database_id": "7d266093-e2b2-4247-88a2-0bd77438c642",
			"remote": true
		}
	]
}
